  "label": {
    "rootCause": "dependency_timeout",
    "evidenceLines": [
      104,
      113,
      117,
      118,
      119,
      127,
      128
    ],
    "explanation": "A payment-svc reconciler session opened transaction 98979 on postgres and left it open holding a row lock on orders (line 104). Subsequent updates queued behind that lock (lines 113, 119), so payment-svc's queries hit their statement timeout and order-service's calls to payment-svc timed out (lines 117, 118, 127, 128). order-service's connection pool to payment-svc saturating (lines 133, 142) and the api-gateway 504s (lines 134, 148, 158, 173) are downstream symptoms. The fix is to kill the idle-in-transaction session, not to add capacity. Red herrings: line 21 (a config reload that changed nothing).",
    "difficulty": "easy",
    "acceptableCauses": [],
    "scenario": "dependency_timeout/db-lock-wait"
  }
}
